{
  "name": "traktiva",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:electron": "concurrently -k -n next,electron \"next dev\" \"electron .\"",
    "dev:electron:license": "concurrently -k -n next,electron \"next dev\" \"electron . --license\"",
    "build": "next build && node -e \"const fs=require('fs');fs.rmSync('.next/standalone/data',{recursive:true,force:true});fs.cpSync('.next/static','.next/standalone/.next/static',{recursive:true});fs.cpSync('public','.next/standalone/public',{recursive:true});fs.cpSync('drizzle','.next/standalone/drizzle',{recursive:true})\"",
    "start": "node .next/standalone/server.js",
    "dist": "npm run build && electron-builder --win --x64",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@libsql/client": "^0.18.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.74.0",
    "next": "16.4.6",
    "playwright-core": "<1.63",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "simple-icons": "^16.38.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "shadcn": "^4.23.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron@45.3.3": true,
    "electron-winstaller@5.4.0": true,
    "better-sqlite3@13.2.0": true,
    "ffmpeg-static@5.3.0": true
  },
  "main": "electron/main.js",
  "description": "Traktiva - auto upload & AI content studio",
  "build": {
    "appId": "com.traktiva.app",
    "productName": "Traktiva",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "resources/icon.png",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Traktiva",
      "artifactName": "Traktiva-Setup-${version}.${ext}"
    },
    "afterPack": "scripts/after-pack.js",
    "icon": "resources/icon.png"
  }
}
