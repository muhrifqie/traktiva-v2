+def _add_resolution_aliases():
+    for name, cfg in list(MODEL_CONFIG.items()):
+        if cfg.get("type") == "video" and cfg.get("video_type") == "omni" and not name.endswith("-360p"):
+            # the Flow web app asks for the 360p variant of the model key (e.g. macaron_cookie_t2v_8s_360p) plus
+            # the output resolution [4] (captured from its request, 2026-11-22)
+            alias = {**cfg, "resolution_override": "VIDEO_RESOLUTION_360P"}
+            for key in ("model_key", "reference_model_key"):
+                if alias.get(key) and not str(alias[key]).endswith("_360p"):
+                    alias[key] = f"{alias[key]}_360p"
+            MODEL_CONFIG[f"{name}-360p"] = alias
+
+
+_add_resolution_aliases()
